{
  "name": "collab-board",
  "private": true,
  "description": "Real-time collaborative whiteboard (Next.js + Node.js + Yjs)",
  "packageManager": "pnpm@8.14.3",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "pnpm --filter @collab-board/shared build && pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @collab-board/web dev",
    "dev:server": "pnpm --filter @collab-board/server dev",
    "build": "pnpm --filter @collab-board/shared build && pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
