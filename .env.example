# Server
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
# Signs board access tokens. Required in production: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
# Set to true behind a reverse proxy (e.g. Coolify), so rate limiting sees the real client IP
TRUST_PROXY=false

# Database (docker compose)
DATABASE_URL=postgresql://collab:collab@localhost:5433/collab_board

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# WebSocket endpoint for real-time collaboration
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
